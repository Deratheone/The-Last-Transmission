#include <WiFi.h>
#include <WebServer.h>

// ==========================================================
// Stage 3 - EVA Memory Relay Web Challenge
// ESP32 Access Point + Embedded Web Game (HTML/CSS/JS/SVG inline)
//
// NOTE ON SIZE: the embedded page (including the inline SVG memory
// image) is ~570KB. That is too large to build as a String at
// runtime (ESP32 SRAM is only ~320KB total), so this page is stored
// in flash (PROGMEM) and streamed directly to the client with
// server.send_P() instead of being copied into a String first.
// Because of that, %NEXT_ROOM%/%NEXT_CODE% placeholder substitution
// was dropped -- the room/code text below is baked into the page
// as plain text (it already matches NEXT_ROOM/NEXT_CODE).
// ==========================================================

// ---------- WiFi AP Configuration ----------
const char* AP_SSID = "EVA-MEMORY-3";
const char* AP_PASSWORD = "1234567890";  // Shared six-digit access code

// ---------- Next Stage Output (kept for reference / Serial log only) ----------
const char* NEXT_ROOM = "Room No: 4";
const char* NEXT_CODE = "123456";

WebServer server(80);

